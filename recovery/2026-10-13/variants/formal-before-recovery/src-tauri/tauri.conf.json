{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WithType",
  "mainBinaryName": "withtype",
  "version": "0.1.0",
  "identifier": "app.typefree.windows.unofficial",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/client"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "visible": false,
        "title": "WithType",
        "width": 1060,
        "height": 720,
        "minWidth": 860,
        "minHeight": 620,
        "center": true,
        "decorations": true,
        "resizable": true,
        "theme": "Light",
        "backgroundColor": "#f8f7ef"
      },
      {
        "label": "overlay",
        "title": "WithType · 录音",
        "width": 176,
        "height": 54,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "theme": "Light",
        "backgroundColor": "#00000000"
      },
      {
        "label": "answer",
        "title": "WithType · 随便问",
        "width": 420,
        "height": 320,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "theme": "Light",
        "backgroundColor": "#fcfcf8"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "resources": {
      "WebView2Loader.dll": "WebView2Loader.dll",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../LICENSES/Typefree-GPL-3.0.txt": "LICENSES/Typefree-GPL-3.0.txt",
      "../public/fonts/OFL-NotoSansSC.txt": "LICENSES/OFL-NotoSansSC.txt",
      "../public/fonts/COPYRIGHT-NotoSansSC.txt": "LICENSES/COPYRIGHT-NotoSansSC.txt"
    },
    "category": "Productivity",
    "shortDescription": "WithType Windows 语音输入",
    "longDescription": "用语音输入文字、翻译或提问。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
